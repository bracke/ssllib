with "config/ssllib_tests_config.gpr";
with "ssllib.gpr";
with "project_tools.gpr";
with "aunit.gpr";

--  The test and tooling crate. Two executables share one crate because they
--  share the fixtures: ssllib_tests is the AUnit runner, ssllib_tools is the
--  Ada driver for build, test, proof, documentation, verification, packaging
--  and release. The runtime library depends on neither.
project Ssllib_Tests is

   for Source_Dirs use ("src/", "src/tools/", "config/");
   for Object_Dir use "obj/" & Ssllib_Tests_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("ssllib_tests.adb", "ssllib_tools.adb", "ssllib_peer.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        Ssllib_Tests_Config.Ada_Compiler_Switches
        & ("-gnat2022", "-gnatyM120", "-gnatX", "-gnata");
   end Compiler;

   --  -Wb: Alire's default -gnatW8 makes GNAT emit source text as UTF-8; the
   --  binder must be told the sources are already UTF-8 so it does not
   --  double-encode wide characters in generated string literals.
   package Binder is
      for Switches ("Ada") use ("-Es", "-Wb");
   end Binder;

end Ssllib_Tests;
